rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTask(request.resource.data);
      allow update: if isSignedIn() && isValidTask(request.resource.data) 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'status', 'category', 'priority', 'dueDate', 'assigneeName', 'assigneeAvatar', 'timeSpent', 'updatedAt']);
      allow delete: if isSignedIn();

      function isValidTask(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 200
            && data.status in ['todo', 'in_progress', 'review', 'completed']
            && (data.get('priority', 'medium') in ['low', 'medium', 'high'])
            // Simplified for brevity, add more as needed
            ;
      }
    }

    // Chats collection
    match /chats/{chatId} {
      allow read: if isSignedIn(); // For demo, allow all signed in users. In production, check userId.
      allow write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
